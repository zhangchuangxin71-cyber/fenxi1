# ============================================================
# 复制为 .env 后填写真实值：  cp .env.example .env
# docker compose / ./start.sh 会读取本文件做变量替换。
# 运行模型：单 API 进程内存账本 + 同进程后台任务（无 Postgres/Redis）。
# 进程重启后 video_id / job_id 全部失效，请及时保存返回的 OSS 对象列表。
# 改完 .env 后需重启 API 才生效。
# ============================================================

# --- 豆包语义分镜（可选；仅 detector=semantic 需要）---
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-1-pro-260628
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_TIMEOUT=600
# SEMANTIC_SAMPLE_FPS=1.0

# --- 阿里云 OSS（导入源片 / 预存切片，生产必填）---
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# CDN 不可用或未配置时，oss_url 回退为签名 URL；有效期（秒）
OSS_SIGN_EXPIRES=3600
# FFmpeg/FFprobe 远程读取 OSS 时使用的长时效 URL（默认 6 小时）
OSS_PROCESS_SIGN_EXPIRES=21600
# FFmpeg stdout → OSS multipart 的分片大小（MiB）
OSS_MULTIPART_PART_SIZE_MB=8
# URL 转存源片与派生资源前缀
OSS_INGEST_PREFIX=video-clip/_ingest/
OSS_DERIVED_PREFIX=video-clip/_derived/
OSS_MANAGED_SOURCE_RETENTION_HOURS=48
# OSS 下载失败自动重试次数（不含首次）；≤0 关闭
OSS_DOWNLOAD_RETRIES=3
# 重试基础等待秒（指数退避：1.5 → 3 → 6 …）
OSS_DOWNLOAD_RETRY_BASE_SLEEP=1.5
# 可选公网源片域名白名单；配置后仅允许这些主机导入
# IMPORT_ALLOWED_HOSTS=example-bucket.oss-cn-region.aliyuncs.com
# 可选强制开关：true/false；默认按四元组是否齐全自动判断
# OSS_ENABLED=

# --- 前端跨域 / 对外媒体 URL ---
# 逗号分隔 Origin；默认已含本地 Vite；生产务必加上真实前端域名
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173

# 本机媒体绝对 URL 前缀（胶片条 filmstrip_url、未走 CDN 时的 /media、片段预览等）
# 留空则按当前请求 Host 拼接；经网关/反代或 Windows 前端联调 Linux API 时填写公网 Origin
# 正确：API_PUBLIC_BASE=http://39.108.184.150:8010

# OSS 公网 CDN 前缀（推荐，不要末尾斜杠）
# 源片 preview_url 规则：URL 会先流式转存受管 OSS；媒体接口优先 CDN，
# CDN 不可用时 302 到临时 OSS 签名 URL，视频字节不经过 API。
#   - 未配 CDN 时兜底    → {API_PUBLIC_BASE或Host}/api/v1/videos/{id}/media
# filmstrip_url 始终走本机 API（与 CDN 无关）
# 源片与 clips 切片的 oss_url：优先返回 CDN 地址，CDN 不可用时返回签名 URL
OSS_CDN_BASE=https://cdn.example.com

# --- 同进程并发与内存上限 ---
# 同时后台任务数（导入/分镜/切割）；峰值 ffmpeg ≈ 本值 × CUT_MAX_WORKERS
INLINE_MAX_JOBS=4
# 单个切割任务内并行 ffmpeg 路数（建议 2～6）
CUT_MAX_WORKERS=4
# 内存中视频 / 任务条数上限（≤0 不限制）
MAX_INMEM_VIDEOS=200
MAX_INMEM_TASKS=500

# --- 清理 ---
# 卡住任务（pending/detecting/processing）与 importing 超时回收（小时）
STALE_TASK_HOURS=12
# done/preview/failed 本地成品与内存记录保留期（小时）；≤0 关闭按龄回收
LOCAL_RETENTION_HOURS=48
# 周期清理间隔（分钟）；≤0 关闭定时（启动时仍会跑一轮）
CLEANUP_INTERVAL_MINUTES=30
# data 盘剩余低于该值（GiB）时忽略保留期优先清最旧本地文件；≤0 关闭
DISK_FREE_GB_MIN=5

# --- 宿主机端口映射 / 镜像名 ---
API_PORT=8010
# Compose 使用的镜像名；离线 load 或仓库 pull 后保持一致即可
# IMAGE=video-clip-api:latest
