# ARK 平台 API 密钥；需替换为真实值。
ARK_API_KEY=your_ark_api_key

# ARK OpenAI 兼容接口基础地址；通常保留默认值即可。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 默认模型名；通常使用团队统一可用模型。
ARK_MODEL=doubao-seed-2-0-lite-260215

# 单次 LLM 调用超时时间（秒）。
DA_LLM_TIMEOUT_SECONDS=60

# PostgreSQL 连接串；需替换为可访问数据库的真实值。
POSTGRES_DSN=postgresql://postgres:password@127.0.0.1:5432/pageindex

# 业务侧用户标识；通常保留默认值即可。
# 默认情况下，PostgreSQL 检索会按 user_id 隔离：
# - DA_USER_ID=system 时，只能看到 user_id=system 的文档
# - DA_USER_ID=alice 时，只能看到 user_id=alice 的文档
# - DA_USER_ID=* 时，直接关闭 user_id 过滤，可看到所有 user_id 的文档
DA_USER_ID=system

# PageIndex 兼容用户标识；未设置 DA_USER_ID 时可作为回退。
PAGEINDEX_USER_ID=system

# 是否显式关闭 user_id 隔离。
# 这个开关的作用是：保留当前 DA_USER_ID 配置不变，但查询时不再按 user_id 过滤。
# 适合需要继续保留 DA_USER_ID=system 等固定值、又想临时检索全库的场景。
# - 设为 0：仍按 DA_USER_ID / PAGEINDEX_USER_ID 隔离
# - 设为 1/true/yes/on：忽略 user_id 过滤，可看到所有 user_id 的文档
# 如果你已经把 DA_USER_ID 设为 *，通常不必再单独开启这个开关。
DA_DISABLE_USER_SCOPE=0
