# MinerU CPU runtime
MINERU_MODEL_SOURCE=modelscope
MINERU_DEVICE_MODE=cpu
MINERU_API_MAX_CONCURRENT_REQUESTS=4
MINERU_API_TASK_RETENTION_SECONDS=3600
MINERU_API_TASK_CLEANUP_INTERVAL_SECONDS=300
MINERU_API_OUTPUT_ROOT=/data/output/_api_tasks
MINERU_PDF_RENDER_THREADS=4
MINERU_PROCESSING_WINDOW_SIZE=16
MINERU_INTRA_OP_NUM_THREADS=4
MINERU_INTER_OP_NUM_THREADS=1
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
CUDA_VISIBLE_DEVICES=
NVIDIA_VISIBLE_DEVICES=void
NVIDIA_DRIVER_CAPABILITIES=

# Optional Jina Reader support for HTML URLs.
JINA_API_KEY=
JINA_READER_BASE_URL=https://r.jina.ai/
