# Service
APP_HOST=0.0.0.0
APP_PORT=8100
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# External production PostgreSQL. Replace every angle-bracket placeholder.
POSTGRES_DSN=postgresql://<user>:<password>@<host>:5432/<database>
DA_USER_ID=system
PAGEINDEX_USER_ID=system

# Ark / LLM
ARK_API_KEY=<ark-api-key>
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-mini-260428
ARK_ENDPOINT_ID=doubao-seed-2-0-mini-260428
ARK_VISION_MODEL=doubao-seed-2-0-mini-260428
DA_LLM_TIMEOUT_SECONDS=45
INGEST_SUMMARY_CONCURRENCY=5
DA_SUMMARY_CONCURRENCY=5
INGEST_SUMMARY_RATE_LIMIT_PER_SEC=5.0
INGEST_PDF_VISION_CONCURRENCY=5
INGEST_PDF_VISION_RATE_LIMIT_PER_SEC=5.0
DA_PDF_VISION_CONCURRENCY=5

# Aliyun OSS
OSS_BUCKET=<oss-bucket>
OSS_ENDPOINT=<oss-endpoint>
OSS_REGION=<oss-region>
OSS_ACCESS_KEY_ID=<oss-access-key-id>
OSS_ACCESS_KEY_SECRET=<oss-access-key-secret>

# MinerU uses the Compose service name and container port.
INGEST_PARSER_BACKEND=mineru
MINERU_API_URL=http://mineru-api:8135
MINERU_BACKEND=pipeline
MINERU_PARSE_METHOD=auto
MINERU_LANG=ch
MINERU_USE_ASYNC_TASKS=true
MINERU_FALLBACK_TO_NATIVE=true
MINERU_CLIENT_CONCURRENCY=4
MINERU_PARSE_TIMEOUT_SECONDS=1800
MINERU_PARSE_RETRY_TIMES=2
MINERU_PARSE_RETRY_BACKOFF_BASE=1.5
MINERU_TASK_POLL_INTERVAL_SECONDS=2
INGEST_WEAK_HEADING_SPLIT_ENABLED=true
INGEST_WEAK_HEADING_SPLIT_MIN_CHARS=800
INGEST_WEAK_HEADING_SPLIT_MAX_CHARS=8000

# Ingestion runtime
INGEST_API_PREFIX=/ingestion/v1
INGEST_HEALTH_PATH=/healthz
INGEST_WORKER_CONCURRENCY=4
TEMP_INGEST_WORKER_CONCURRENCY=2
INGEST_DB_BATCH_SIZE=500
INGEST_EVENT_PROGRESS_STEP=5
INGEST_EVENT_MIN_INTERVAL_SECONDS=1
INGEST_INDEX_CONCURRENCY=1
INGEST_TASK_TIMEOUT_SECONDS=2400
INGEST_EXPOSE_RUNTIME_ERROR=false
INGEST_WORKSPACE_DIR=/app/app/workspace
INGEST_LOG_FILE=/app/logs/app.log
INGEST_LOG_ARCHIVE_ENABLED=true
INGEST_LOG_OSS_PREFIX=prod/doc-ingestion/logs
INGEST_LOG_TIMEZONE=Asia/Shanghai
INGEST_LOG_DELETE_ON_SHUTDOWN=true

# Callback stays disabled until whitelist and secret are provisioned.
INGEST_CALLBACK_ALLOWED_SCHEMES=https
INGEST_CALLBACK_WHITELIST=
INGEST_CALLBACK_ENABLED=false
INGEST_CALLBACK_SECRET=
INGEST_CALLBACK_CONNECT_TIMEOUT=3
INGEST_CALLBACK_READ_TIMEOUT=5
INGEST_CALLBACK_MAX_RETRIES=3
INGEST_CALLBACK_BASE_BACKOFF=2

# Cleanup and ETA
INGEST_CLEANUP_SCHEMA=public
INGEST_CLEANUP_TABLES=doc_nodes,doc_pages,documents
INGEST_TREE_NODES_TABLE=doc_nodes
INGEST_ETA_VISION_PAGE_SECONDS=8
INGEST_ETA_SUMMARY_NODE_SECONDS=0.8
INGEST_ETA_NORMAL_PARSE_PAGE_SECONDS=0.05
INGEST_ETA_STORE_SECONDS=2
INGEST_ETA_PDF_BYTES_PER_PAGE=200000
INGEST_ETA_PPTX_BYTES_PER_PAGE=400000
INGEST_ETA_XLSX_BYTES_PER_PAGE=120000
INGEST_ETA_DOCX_BYTES_PER_PAGE=80000
INGEST_ETA_TEXT_BYTES_PER_PAGE=3000
