# Service
APP_NAME=rag-agent
APP_ENV=prod
HOST=0.0.0.0
PORT=8115
APP_PORT=8115
LOG_LEVEL=INFO

# External production PostgreSQL, retained for document metadata compatibility.
PG_DSN=postgresql://<user>:<password>@<host>:5432/<database>

# Standalone retrieval service
RAG_TOP_K=5
RAG_SEARCH_MODE=hybrid
RAG_MAX_CANDIDATES=500
RAG_RETRIEVAL_BACKEND=remote
RAG_RETRIEVAL_SERVICE_URL=http://rag-retrieval-service:8120
RAG_RETRIEVAL_TIMEOUT_SECONDS=180
DOC_ROUTER_MAX_DOCS=50

# Ark
ARK_API_KEY=<ark-api-key>
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL_MINI=doubao-seed-2-0-lite-260215
MODEL_FAST=doubao-seed-2-0-lite-260215
MODEL_SMART=doubao-seed-2-0-lite-260215
DOUBAO_THINKING_TYPE=enabled
DOUBAO_REASONING_EFFORT=medium
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Optional report images
REPORT_IMAGE_ENABLED=false
REPORT_IMAGE_MAX_SECTIONS=3
REPORT_IMAGE_TOP_K=3
IMAGE_MCP_URL=
IMAGE_MCP_API_TYPE=generic
IMAGE_MCP_API_KEY=
IMAGE_MCP_TENANT_CODE=
IMAGE_MCP_TIMEOUT_SECONDS=20

# Optional OSS logs
OSS_ENABLED=false
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_LOG_PREFIX=rag-agent/logs/
