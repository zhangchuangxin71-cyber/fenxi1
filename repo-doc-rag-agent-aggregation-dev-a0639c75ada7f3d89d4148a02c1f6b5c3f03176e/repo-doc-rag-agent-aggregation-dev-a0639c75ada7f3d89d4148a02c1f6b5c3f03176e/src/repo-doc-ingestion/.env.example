# Copy this file to `.env` and fill in real values for local development.
# Do not commit `.env`.

# ---------------------------------------------------------------------------
# Docker Compose deployment
# ---------------------------------------------------------------------------

# The ingestion API has no built-in service authentication. Keep the default
# loopback binding and expose it only through an authenticated gateway/firewall.
APP_HOST=127.0.0.1
# Public host port and container listening port for the FastAPI service.
APP_PORT=8100

# PostgreSQL container bootstrap values. Change POSTGRES_PASSWORD in production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=pageindex

# Required host path on the server data disk. The postgres container stores all
# database files here through docker-compose.yml. Fill it after checking the
# server mount points with `lsblk`/`df`.
#
# Examples:
# PGDATA_HOST_PATH=/mnt/data/pageindex/postgres
# PGDATA_HOST_PATH=/var/lib/pageindex/postgres  # only if /var is on data disk
PGDATA_HOST_PATH=

# Container timezone.
TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# Ark / LLM
# ---------------------------------------------------------------------------

# Ark API key used by summary generation and vision OCR.
ARK_API_KEY=your_ark_api_key_here

# Ark OpenAI-compatible base URL.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Default text model / endpoint for summaries.
ARK_MODEL=doubao-seed-2-0-mini-260428
ARK_ENDPOINT_ID=doubao-seed-2-0-mini-260428

# Vision-capable model / endpoint for complex PDF or OCR PDF pages.
ARK_VISION_MODEL=doubao-seed-2-0-mini-260428

# Disable deep reasoning for ingestion workloads unless you explicitly need it.
# Supported values depend on the selected Ark model, e.g. minimal/low/medium/high.

# Single LLM call timeout in seconds.
DA_LLM_TIMEOUT_SECONDS=45

# Single-instance production budget. A task may index multiple documents and
# every document may fan out LLM calls, so the effective upper bound is roughly:
# (normal + temporary workers) * index concurrency * per-document concurrency.
# The values below keep that bound at (4 + 2) * 1 * 5 = 30 Ark calls.
INGEST_SUMMARY_CONCURRENCY=5
# Keep the legacy/ETA alias aligned with the effective runtime setting above.
DA_SUMMARY_CONCURRENCY=5
# Process-wide pacing guard; 5.0 = 300 summary calls/minute.
INGEST_SUMMARY_RATE_LIMIT_PER_SEC=5.0
INGEST_PDF_VISION_CONCURRENCY=5
# Process-wide pacing guard; 5.0 = 300 vision calls/minute.
INGEST_PDF_VISION_RATE_LIMIT_PER_SEC=5.0
DA_PDF_VISION_CONCURRENCY=5

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# PostgreSQL DSN for documents/doc_nodes/doc_pages and ingestion task tables.
# Local Python/dev example:
POSTGRES_DSN=postgresql://postgres:change_me_strong_password@127.0.0.1:5432/pageindex
#
# In docker-compose.yml the app container overrides POSTGRES_DSN to use the
# internal service hostname `postgres`, so this 127.0.0.1 value will not break
# Compose deployment.

# User/tenant namespace used by the storage layer.
DA_USER_ID=system
PAGEINDEX_USER_ID=system

# ---------------------------------------------------------------------------
# Aliyun OSS
# ---------------------------------------------------------------------------

# Required for document uploads. The API accepts OSS object keys only.
# Credentials are read by oss2 from standard environment variables:
# OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET / optional OSS_SECURITY_TOKEN.
OSS_BUCKET=your_bucket_name
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_REGION=cn-shenzhen
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret


# ---------------------------------------------------------------------------
# Parser backend
# ---------------------------------------------------------------------------

# native: use the built-in parser.
# mineru: send documents to the external MinerU API and then map its output
#         back to the same PageIndex documents/doc_nodes/doc_pages structure.
INGEST_PARSER_BACKEND=mineru
# Must be reachable from the app runtime. In Compose/Kubernetes use the MinerU
# service DNS name; 127.0.0.1 only works when both processes share a host.
MINERU_API_URL=http://mineru-api:8135
MINERU_BACKEND=pipeline
MINERU_PARSE_METHOD=auto
MINERU_LANG=ch
MINERU_USE_ASYNC_TASKS=true
MINERU_FALLBACK_TO_NATIVE=true
MINERU_CLIENT_CONCURRENCY=4
MINERU_PARSE_TIMEOUT_SECONDS=1800
MINERU_PARSE_RETRY_TIMES=2
MINERU_PARSE_RETRY_BACKOFF_BASE=1.5
MINERU_TASK_POLL_INTERVAL_SECONDS=2

# Optional postprocess for MinerU md/txt output. It only splits overlong leaf
# nodes by conservative weak headings, then paragraphs/fixed length fallback.
INGEST_WEAK_HEADING_SPLIT_ENABLED=true
INGEST_WEAK_HEADING_SPLIT_MIN_CHARS=800
INGEST_WEAK_HEADING_SPLIT_MAX_CHARS=8000

# ---------------------------------------------------------------------------
# Ingestion API
# ---------------------------------------------------------------------------

# API route prefix and health endpoint.
INGEST_API_PREFIX=/ingestion/v1
INGEST_HEALTH_PATH=/healthz

# Worker concurrency: number of background ingestion workers.
INGEST_WORKER_CONCURRENCY=4
# Dedicated temporary-document workers. These consume only the high-priority queue.
TEMP_INGEST_WORKER_CONCURRENCY=2
INGEST_DB_BATCH_SIZE=500
# Task event throttling: always persist status transitions/final events;
# persist progress events when progress changes by this percentage or this many seconds pass.
INGEST_EVENT_PROGRESS_STEP=5
INGEST_EVENT_MIN_INTERVAL_SECONDS=1

# Per-task document indexing concurrency. Keep this at 1 while six workers and
# per-document Ark concurrency 5 share one API key; raising it multiplies calls.
INGEST_INDEX_CONCURRENCY=1

# Max execution time for one ingestion task. Keep this greater than the MinerU
# parse timeout plus conversion and persistence overhead.
INGEST_TASK_TIMEOUT_SECONDS=2400

# Whether API error responses expose detailed runtime exceptions.
INGEST_EXPOSE_RUNTIME_ERROR=false

# Working directory. Leave empty to use the default app/workspace directory.
INGEST_WORKSPACE_DIR=

# Service log archive. Local log remains on disk; a Markdown copy is uploaded
# to OSS on normal FastAPI shutdown.
INGEST_LOG_FILE=app.log
INGEST_LOG_ARCHIVE_ENABLED=true
INGEST_LOG_OSS_PREFIX=prod/doc-ingestion/logs
INGEST_LOG_TIMEZONE=Asia/Shanghai
INGEST_LOG_DELETE_ON_SHUTDOWN=true

# ---------------------------------------------------------------------------
# Callback
# ---------------------------------------------------------------------------

# Callback URL safety controls. Keep disabled until a non-empty hostname
# whitelist and secret are provisioned; an empty whitelist is not production-safe.
INGEST_CALLBACK_ALLOWED_SCHEMES=http,https
INGEST_CALLBACK_WHITELIST=
INGEST_CALLBACK_ENABLED=false
INGEST_CALLBACK_SECRET=
INGEST_CALLBACK_CONNECT_TIMEOUT=3
INGEST_CALLBACK_READ_TIMEOUT=5
INGEST_CALLBACK_MAX_RETRIES=3
INGEST_CALLBACK_BASE_BACKOFF=2

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------

# Tables cleaned when deleting documents via API.
INGEST_CLEANUP_SCHEMA=public
INGEST_CLEANUP_TABLES=doc_nodes,doc_pages,documents
INGEST_TREE_NODES_TABLE=doc_nodes

# ---------------------------------------------------------------------------
# ETA estimation
# ---------------------------------------------------------------------------

# These values only affect estimated_seconds in submit responses.
INGEST_ETA_VISION_PAGE_SECONDS=8
INGEST_ETA_SUMMARY_NODE_SECONDS=0.8
INGEST_ETA_NORMAL_PARSE_PAGE_SECONDS=0.05
INGEST_ETA_STORE_SECONDS=2
INGEST_ETA_PDF_BYTES_PER_PAGE=200000
INGEST_ETA_PPTX_BYTES_PER_PAGE=400000
INGEST_ETA_XLSX_BYTES_PER_PAGE=120000
INGEST_ETA_DOCX_BYTES_PER_PAGE=80000
INGEST_ETA_TEXT_BYTES_PER_PAGE=3000
