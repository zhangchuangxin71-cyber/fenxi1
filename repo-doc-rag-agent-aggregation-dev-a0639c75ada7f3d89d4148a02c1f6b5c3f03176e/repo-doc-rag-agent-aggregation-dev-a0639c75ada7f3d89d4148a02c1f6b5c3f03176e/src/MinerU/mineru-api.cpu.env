MINERU_MODEL_SOURCE=modelscope
MINERU_DEVICE_MODE=cpu
MINERU_API_MAX_CONCURRENT_REQUESTS=8
MINERU_API_TASK_RETENTION_SECONDS=3600
MINERU_API_TASK_CLEANUP_INTERVAL_SECONDS=300
MINERU_API_OUTPUT_ROOT=./output_cpu/_api_tasks
MINERU_PDF_RENDER_THREADS=4
MINERU_PROCESSING_WINDOW_SIZE=16
MINERU_INTRA_OP_NUM_THREADS=4
MINERU_INTER_OP_NUM_THREADS=1
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
CUDA_VISIBLE_DEVICES=

# HTML URL parsing uses Jina Reader API.
# Do not commit a real key. Set it in the shell before sourcing this file,
# or copy this file to .env.mineru-api locally and edit that ignored file.
JINA_API_KEY=${JINA_API_KEY:-}
JINA_READER_BASE_URL=${JINA_READER_BASE_URL:-https://r.jina.ai/}
