# New retrieval service configuration. Do not copy the legacy service's auth
# settings: this service is intentionally deployed behind a trusted caller.
APP_NAME=rag-retrieval-service
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8120
APP_MAX_CONCURRENCY=30
APP_MAX_QUEUED_REQUESTS=90
APP_ADMISSION_WAIT_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO

# PostgreSQL used by the ingestion service. Keep credentials in deployment
# secrets; this file is only a configuration template.
POSTGRES_DSN=postgresql://user:password@postgres:5432/database

# Internal ingestion endpoint used only to repair missing MinerU raw artifacts.
INGESTION_SERVICE_BASE_URL=http://127.0.0.1:8100
INGESTION_REPAIR_TIMEOUT_SECONDS=10
DB_POOL_MIN=1
DB_POOL_MAX=30
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=10
DB_QUERY_TIMEOUT_SECONDS=60
DB_POOL_IDLE_TTL_SECONDS=120
DB_POOL_REAPER_INTERVAL_SECONDS=30

# Retrieval compatibility and response budgets.
RAG_API_PREFIX=/rag/v1
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=100
RAG_MAX_DOC_IDS=100
RAG_DEFAULT_RETURN_TOKENS=8192
RAG_MIN_RETURN_TOKENS=128
RAG_MAX_RETURN_TOKENS=180000
RAG_DEFAULT_INCLUDE_DOCUMENT_META=true
RAG_DOCUMENT_PREFILTER_THRESHOLD=0.05
RAG_DOCUMENT_PREFILTER_MAX_CANDIDATES=32
RAG_TREE_MAX_STEPS=4
RAG_TREE_SCAN_MAX_TOKENS=4096
RAG_PAGE_ACCEPT_SCORE=20
RAG_PAGE_POSSIBLE_SCORE=1
RAG_MINIMUM_PAGE_TOKENS=64
RAG_QUERY_CLASSIFICATION_STRATEGY=robust

# Ark is used only by semantic/hybrid mode. In local smoke tests, copy the
# corresponding Ark values from the legacy .env into the ignored new .env;
# never commit the resulting file or print its contents.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
RAG_LLM_MODEL=
RAG_LLM_CONTEXT_WINDOW=32768
RAG_LLM_MAX_OUTPUT_TOKENS=2048
RAG_LLM_SAFETY_MARGIN_TOKENS=1024
RAG_LLM_TIMEOUT_SECONDS=90
RAG_LLM_MAX_RETRIES=0
RAG_LLM_MAX_CONCURRENCY=16
RAG_LLM_MAX_QUEUED_CALLS=1024
RAG_LLM_PER_REQUEST_MAX_IN_FLIGHT=6
RAG_LLM_CIRCUIT_BREAKER_ENABLED=true
RAG_LLM_CIRCUIT_FAILURE_THRESHOLD=3
RAG_LLM_CIRCUIT_RECOVERY_SECONDS=30

# A request stops optional post-checkpoint work at the soft deadline and is
# hard-stopped at the later deadline. Keep enough finalization time for merge.
REQUEST_SOFT_DEADLINE_SECONDS=600
REQUEST_HARD_DEADLINE_SECONDS=900
REQUEST_FINALIZATION_RESERVE_SECONDS=30

# Debug is opt-in at both process and request level. Trace output is metadata
# only and never contains document content, prompts, keys or provider bodies.
RAG_DEBUG_ENABLED=false

# User-level external retrieval RPM, enforced before the graph. It is
# process-local, so use one worker per instance and scale with more instances
# only when distributed quota semantics are acceptable.
RAG_RATE_LIMIT_ENABLED=true
RAG_RATE_LIMIT_PER_MINUTE=1200
RAG_RATE_LIMIT_BURST=300
RAG_RATE_LIMIT_BUCKET_TTL_SECONDS=900
