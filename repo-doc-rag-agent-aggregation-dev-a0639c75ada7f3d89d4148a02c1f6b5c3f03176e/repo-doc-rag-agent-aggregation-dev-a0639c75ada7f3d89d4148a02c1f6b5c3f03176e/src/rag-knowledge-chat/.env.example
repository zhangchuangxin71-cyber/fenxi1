# Single-container production template. Keep the host binding private unless an
# authenticated gateway is placed in front of the service.
APP_ENV=prod
APP_HOST=127.0.0.1
APP_PORT=8130
# Shared private network used to resolve rag-retrieval-service.
RAG_DOCKER_NETWORK=pageindex
DEBUG_ENABLED=false
AUTH_ENABLED=false
KNOWLEDGE_CHAT_INBOUND_API_KEYS=

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL_SMART=doubao-seed-2-0-lite-260215
DOUBAO_THINKING_TYPE=enabled

# Use the retrieval container DNS name when both services share a private
# network. For host-based development use http://127.0.0.1:8120 instead.
RAG_RETRIEVAL_SERVICE_URL=http://rag-retrieval-service:8120
RAG_RETRIEVAL_TIMEOUT_SECONDS=180
RAG_MAX_RETURN_TOKENS=180000

# Request quota is keyed by caller fingerprint + user_id. The Ark quota is
# process-global; each chat request uses at most two Ark calls.
REQUEST_RPM_LIMIT=600
ARK_RPM_LIMIT=1800
ARK_MAX_CONCURRENCY=30
