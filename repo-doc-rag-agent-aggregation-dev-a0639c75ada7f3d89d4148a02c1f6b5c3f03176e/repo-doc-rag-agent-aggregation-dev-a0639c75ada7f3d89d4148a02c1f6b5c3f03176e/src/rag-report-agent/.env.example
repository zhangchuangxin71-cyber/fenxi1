# =========================
# RAG Agent Codex env template
# =========================
# 1. Copy this file to .env before running locally or with Docker.
# 2. Do not commit real API keys, database passwords, or OSS credentials.
# 3. For Docker, do not use 127.0.0.1/localhost in PG_DSN unless the database
#    is inside the same container. See README.md for common DSN examples.

# =========================
# Service
# =========================
APP_NAME=rag-agent
APP_ENV=prod
HOST=0.0.0.0
PORT=8115
APP_PORT=8115
LOG_LEVEL=INFO

# Docker network used to reach repo-doc-ingestion PostgreSQL.
DOCKER_NETWORK=pageindex

# =========================
# PostgreSQL / PageIndex
# =========================
# Unified Docker Compose production deployment:
PG_DSN=postgresql://postgres:change_me_strong_password@postgres:5432/pageindex

# Local host development:
# PG_DSN=postgresql://postgres:change_me@127.0.0.1:5432/pageindex

# Docker run, when PostgreSQL is a host-machine process:
# PG_DSN=postgresql://postgres:change_me@host.docker.internal:5432/pageindex

RAG_TOP_K=5
RAG_SEARCH_MODE=hybrid
RAG_MAX_CANDIDATES=500
# postgres: original in-process PostgreSQL retriever; remote: standalone rag-retrieval-service
RAG_RETRIEVAL_BACKEND=remote
RAG_RETRIEVAL_SERVICE_URL=http://rag-retrieval-service:8120
RAG_RETRIEVAL_TIMEOUT_SECONDS=180
DOC_ROUTER_MAX_DOCS=50

# =========================
# Report images, optional
# =========================
# When enabled, report_write will:
# 1. plan which outline sections need images
# 2. call an image MCP-compatible HTTP endpoint
# 3. pass returned real image URLs to the report writer
# 4. insert selected images with Markdown syntax
REPORT_IMAGE_ENABLED=false
REPORT_IMAGE_MAX_SECTIONS=3
REPORT_IMAGE_TOP_K=3
IMAGE_MCP_URL=
IMAGE_MCP_API_TYPE=generic
# Optional fallback only. Prefer passing image_api_key/image_tenant_code in generation_config.
IMAGE_MCP_API_KEY=
IMAGE_MCP_TENANT_CODE=
IMAGE_MCP_TIMEOUT_SECONDS=20

# =========================
# Doubao / Ark
# =========================
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

MODEL_MINI=doubao-seed-2-0-lite-260215
MODEL_FAST=doubao-seed-2-0-lite-260215
MODEL_SMART=doubao-seed-2-0-lite-260215

DOUBAO_THINKING_TYPE=enabled
DOUBAO_REASONING_EFFORT=medium
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# =========================
# OSS logs, optional
# =========================
OSS_ENABLED=false
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_LOG_PREFIX=rag-agent/logs/
