# cp .env.example .env — 填写密钥；勿提交 .env
# 可选变量见 DOCKER_OPS.md、docs/api-flow-b-fastapi-walkthrough.md

# --- 服务 ---
API_PORT=8787
JOBS_ROOT=./jobs
# 1=阶段完成后上传 OSS 并删除本地 job 目录（split 仅归档 JSON；audio/preview 需 OSS）
JOB_EPHEMERAL=1
# 1=失败/取消/中断后也删除 jobs/{task_id}/（本地调试可设 0）
JOB_DELETE_LOCAL_ON_TERMINAL=1

# --- 并发（全机共享；UVICORN_WORKERS>1 时见 jobs/_coord/ 文件锁）---
# uvicorn worker 进程数（>1 时启用跨进程文件锁协调）
UVICORN_WORKERS=1
# 全机同时执行的 API Job 数（所有 worker 共享，非每 worker 各算）
GLOBAL_JOB_WORKERS=4
# 单进程内 CLIP/ffmpeg 并行线程上限（所有 Job 共享）
CLIP_BUILD_WORKERS=4

# --- OSS（成功上传后删 job 目录；终态清理见 JOB_DELETE_LOCAL_ON_TERMINAL）---
OSS_UPLOAD_ENABLED=1
ALIYUN_OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
# 可选：OSS 区域（V4 签名 / 内网 endpoint 时建议设置，如 cn-shenzhen）
# ALIYUN_OSS_REGION=cn-shenzhen
# 可选：access_key（默认）或 provider_v4（使用 OSS_ACCESS_KEY_ID 等环境变量凭证）
# ALIYUN_OSS_AUTH_MODE=access_key
# 可选：成片 object key 前缀（默认 prod/ImagesVideosText2Video）
# ALIYUN_OSS_PREFIX=prod/ImagesVideosText2Video

# --- 预览视频 OSS 截帧（visual/preview，同 bucket 源）---
# 1=视频预览优先 OSS video/snapshot，避免整段下载
PREVIEW_VIDEO_OSS_SNAPSHOT=1
# fast=最近关键帧（快）；exact=精确时间点
# PREVIEW_VIDEO_SNAPSHOT_MODE=fast
# 截帧失败时回退整段下载
# PREVIEW_VIDEO_SNAPSHOT_FALLBACK=1

# --- 维护接口（可选）---
# purge-workspaces / coord-status 鉴权；未设置则无需 Token
# MAINTENANCE_API_TOKEN=

# --- 分句 ---
TEXT_SPLIT_MODE=llm
ARK_API_KEY=
DOUBAO_MODEL=doubao-seed-2-0-lite-260428
# AI 提示词分块批量（include_ai_prompts=true）：每块最多几句，块内批量、块间并行；0=整片一次 LLM
LLM_PROMPT_CHUNK_SIZE=4
# 单 media_type 内并行块数上限（与 image/video 并行合计约 8 路 LLM）
LLM_PROMPT_CHUNK_WORKERS=4
# 单块 LLM 最大重试次数（格式错误时会附带纠错提示重试）
LLM_PROMPT_MAX_ATTEMPTS=4
# 提示词 LLM 全进程并发上限（与 chunk=4 × image/video 峰值 8 路对齐；失败时可降到 4–6）
LLM_PROMPT_MAX_CONCURRENCY=8
