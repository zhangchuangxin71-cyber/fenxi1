# 复制为 .env 后修改；勿提交 .env 到 Git
# 全部变量及默认值见 embedding_service/PARAMS.md

# 必填：服务端口（1–65535，按环境填写，例如 8030）
EMBEDDING_SERVICE_PORT=

# 必填：图片/视频 embed-jobs（通过 object_key 从 OSS 拉对象）
ALIYUN_OSS_ENDPOINT=https://oss-cn-xxx.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=

# 按需：仅当 API 请求 write_vector=true 写 Milvus 时需要（URI 由运维提供）
# 仅测文本向量、不写库时可不设，或设 VECTOR_STORE=none
# VECTOR_STORE=milvus
# MILVUS_URI=http://<milvus-host>:19530

# 建议：国内下载模型
HF_USE_MIRROR=1

# 可选：OSS 下载超时（秒）；大视频/批量任务建议 300–600（Docker compose 默认 300）
# MEDIA_DOWNLOAD_TIMEOUT=300

# 可选：runtime 临时文件清扫与并发（Docker 默认同 compose，详见 embedding_service/PARAMS.md）
# EMBEDDING_WORKERS=4
# TMP_MAX_AGE_HOURS=6
# RUNTIME_CLEANUP_INTERVAL_HOURS=1
# LOG_MAX_AGE_DAYS=7

# GPU（默认 cpu，按需取消注释）
# CLIP_DEVICE=cuda
# BGE_DEVICE=cuda
